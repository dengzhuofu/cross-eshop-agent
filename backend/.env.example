# ===== LLM provider（SiliconFlow，M0 stub 节点不需要任何 key）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 数据库 =====
# M0 默认 sqlite（零依赖即可跑）；docker-compose 起 postgres 后切换：
# DATABASE_URL=postgresql+asyncpg://crosseshop:crosseshop@localhost:5432/crosseshop
DATABASE_URL=sqlite+aiosqlite:///./demo.db

# ===== M0 demo 开关 =====
# true：审批节点自动放行（dev 全局缺省）；也可在创建工作流时传 auto_approve:false 做工作流级覆盖
# false：发布前经 langgraph interrupt() 挂起，等 Approval Center 人工通过/驳回（M5）
AUTO_APPROVE=true
# interrupt/resume 断点存储（checkpointer 只管恢复，不是状态真源）
CHECKPOINT_DB_PATH=.localdata/checkpoints.db
# 证据完整度阈值，低于它触发研究深化（最多 MAX_RESEARCH_ROUNDS 轮）
EVIDENCE_THRESHOLD=0.7
MAX_RESEARCH_ROUNDS=2
MAX_CRITIQUE_ROUNDS=3

# ===== M8 Demo 兜底缓存 =====
# off=直连 LLM（默认）；read=只读缓存（配合 SILICONFLOW_API_KEY 留空即可离线重放预热的 LLM 产出）；
# readwrite=读+写（预热脚本 scripts/warm_demo_cache.py 专用，把真实 LLM 产出落盘）
DEMO_CACHE_MODE=off
# 缓存文件位置（JSON，key 为请求四元组的 sha256；Phase 2 换语义缓存时接口不变）
DEMO_CACHE_PATH=.localdata/demo_cache.json
